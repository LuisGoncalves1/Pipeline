̃ك̓уууЃЃу҃˃˃҃ǃ׃̃ՃŃ̃у҃؃̓ЃՃփԃӃЃ˃ууɃ˃σуăՃ̓ʃփЃكӃɃ׃у˃΃ÃуσʃσԃуփƃЃ��у˃Ӄ˃уŃԃσ̓΃ȃ̃ԃ˃Ӄ˃Ӄσ݃Ƀ΃σ̓̓Ӄ̓Ӄ҃σӃσӃ̃փσ˃˃ԃՃԃ΃ɃՃփ΃Ƀ̃̃؃ǃ؃̃Ѓ˃Ճσ׃ʃуŃɃ؃ԃӃȃփσу̃փ΃փ҃ԃ̓΃̓ЃӃӃՃǃ҃΃׃ʃӃԃ؃΃˃̓ăʃσ˃փ̓҃Ƀ؃̓ɃԃӃԃσɃ̃ك݃׃ǃՃ̃؃̓҃Ѓ҃ǃ΃ӃЃ˃؃Ѓփ΃ՃӃ΃كԃԃσ΃҃ȃ׃ăЃу҃σЃ˃σɃڃԃ؃уʃуǃσʃ҃σփŃكσ݃ȃσу̃уɃ̃ރЃ҃׃Ѓփ҃΃σ̓σ΃؃σ΃ӃՃʃʃ˃̓Ã̓̃҃ՃƃԃփӃуӃʃփ˃σσ̓ǃ΃Ƀуʃу̓̓ԃσσ̓ރ҃ɃӃ҃ԃȃӃ΃��ԃӃ҃ȃ˃уӃԃ˃̓݃΃Ճ̃̃ЃՃԃ҃؃ууσ̃˃ۃԃ΃ڃ҃Ӄكʃكȃ̓у̓ۃуЃуЃуЃ΃փ҃փكԃՃЃԃӃ̃΃ԃ̓҃σՃуԃЃփ΃ẵ̓уփԃ˃̓σу؃ރ΃Ƀσ˃ڃ˃ӃԃՃɃ΃ԃƃ΃փу΃ك҃Ƀ؃σ̃؃уԃ̃ՃƃЃȃσӃȃ҃ӃރЃ҃؃փ̃̓Ƀ׃Ӄփ΃̓΃Ӄ҃ԃ҃҃˃Ӄ̃҃҃ȃ܃ЃӃӃ̃΃׃ă΃Ƀڃ̓˃҃̓σǃ؃ӃɃуσփ҃ӃԃӃ̃Ճσ҃уڃ҃˃̃Ճ҃׃̃σ̃փԃԃփ΃փ΃Ƀ؃˃փ̓׃̓у҃ӃՃكÃكʃЃփ˃˃Ƀԃʃ˃ɃӃ̓փ΃Ƀʃ̓Ѓ̓ԃ΃˃Ճу�у҃Ӄ̓ЃڃՃӃ̓҃уŃރσɃ؃σ҃΃؃ۃ݃Ӄ̓у׃Ńσԃԃȃփ߃̓Ӄփ̓ӃуσՃ̃ۃ̃ԃփуЃ̃у҃уԃ׃σՃσԃ̓׃̃փ̓̃̓ՃރЃ̃ЃԃӃ؃уɃԃЃσу̓΃ՃՃ̃΃؃ۃ؃̃Ճ΃փԃ҃σӃ΃׃̓уЃ҃ԃԃ׃ՃуՃ̓҃ʃЃڃ؃҃ԃՃ؃҃̃׃Ƀ̃؃؃܃σԃ҃փ҃؃σуӃЃу݃ЃʃЃ҃كσ׃ڃӃ҃փʃуԃ΃ʃЃԃ҃ۃЃԃՃʃ҃΃΃ʃ̃̓�׃҃уԃЃЃƃՃу؃̃˃уу؃҃˃̓Ճ؃σЃЃԃуЃ̓ԃσЃՃɃӃ߃ԃ̓ЃуӃŃу̃҃σՃσЃ̓փуӃ΃փ̃̓΃��Ѓ΃σՃԃ΃уЃՃ΃уփ҃΃΃؃̓Ӄ̓уӃ܃̓΃̃σ׃ЃڃЃ̃ك҃σӃу˃҃ǃ܃уЃЃǃуՃ܃Ճ׃׃σՃ҃˃҃ʃԃ׃Ƀ̓փك؃у̓ڃɃ׃ЃӃʃՃσ̃ȃ҃҃ރ΃̓ЃՃԃŃԃ̓҃˃փ҃ЃЃ҃Ѓу؃Ճ˃փ̃كσփǃۃу؃΃Ӄڃ˃܃Ճ̃ă҃ۃ҃ԃԃ΃Ѓԃ˃Ƀ҃؃ʃЃՃ҃ԃуӃу҃ЃՃуՃփփ؃҃ՃЃ΃σ΃كԃуԃ׃̓ЃӃރӃ˃߃ԃʃ܃˃σ׃ԃۃ΃Ƀ̓̓уу̃Ӄǃփԃ̃Ճуك҃̃уσӃуӃЃՃփ҃كԃӃ̓׃҃׃ɃЃσ׃؃ЃԃփՃу̓؃̓փփك׃ʃڃ׃̃у̓ԃ׃σփԃ؃ՃԃЃЃσՃ؃҃׃ЃۃՃ̃҃σ܃փу҃كԃЃӃՃ׃ككЃՃՃփɃكփ؃؃׃Ӄ܃ԃ̓΃҃ɃӃ܃�ЃӃ˃уՃփՃ̓ۃσ҃̃΃҃΃��΃Ӄփۃ܃ԃ҃݃Ѓ΃Ӄ˃σӃփك̓ԃЃӃ҃΃Ƀσ̃҃ՃσуԃӃ̃؃уʃÃ׃׃˃׃ԃՃ܃ۃσԃууЃ҃΃҃̃Ӄ˃ڃă΃ԃǃڃσԃσ̓Ӄ҃҃̃܃ԃ܃؃҃΃ԃσσӃԃރփՃ˃Ѓ̃σՃу܃փȃփӃԃރЃۃЃۃՃу҃׃ՃՃԃ̃σԃ҃΃ԃՃу΃σ΃Ѓ̃փ̓ۃ˃σ˃ЃӃԃՃփԃӃɃЃփԃԃǃ̓ȃԃ؃ȃӃك׃߃ԃӃՃԃՃ׃σփɃ̃ȃ̃ރӃكσуЃ΃Ճ΃Ӄ׃Ճԃ̓у˃ӃԃԃՃуσӃуփ҃كӃЃ҃̃؃уփ΃уЃ̓ڃ̓؃σуփԃ҃ԃу̓у̓փуكɃՃ˃ԃՃԃӃՃуӃ܃׃ӃՃ̓ӃՃ؃փ΃ЃԃЃЃ҃у҃у҃у̓σ˃ك̃Ѓփ΃ۃ̓�ɃۃʃكփكӃууՃуӃσЃуփ΃ك҃ǃكʃ̓Ѓփ܃уՃ҃ԃ؃˃ԃσ׃у҃Ӄ׃܃Ѓ΃у̓ЃЃ׃փӃփуكЃ҃Ӄ΃у҃Ѓ΃ԃ΃Ճ̃˃σӃӃ׃ڃσуڃуՃ݃ЃӃԃփރ׃݃҃σӃ݃σȃӃ҃҃܃ԃ؃ۃكуσԃ΃ԃ΃̓ӃЃԃЃ׃Ӄ҃ՃЃЃʃՃ̓ԃσ׃̃уЃ̃σЃσԃуу҃ӃЃσ׃Ѓ܃܃ԃ׃׃ԃڃ׃Ѓ؃كՃӃ΃у˃Ѓ΃҃ууՃууʃσσуۃ؃Ճڃރ΃؃؃Ӄ˃Ճ҃ʃЃԃ˃΃ʃ׃Ճ؃܃׃փу΃ӃԃЃ΃փЃ߃݃҃ԃ҃؃уՃ΃уσփ̃ՃɃ˃փ̓Ƀԃ΃уԃЃփ˃܃҃ڃՃ̓΃Ճԃ̓ууӃՃӃփǃ׃ԃЃ˃σ̓̃уՃσڃ؃ʃԃ̓փԃ܃̓Ӄ̃ԃՃփԃуԃ҃փރՃ˃ۃ҃�ڃу҃΃ԃȃ̓ԃЃЃуكЃʃσփӃԃЃփуЃӃ؃̓σʃ΃΃ȃ̃΃у׃׃у̓ǃ҃ՃЃ̓҃��ԃǃууك˃׃ƃԃ҃̓̃փ׃уӃʃԃ̃΃ڃσσσσу҃Ӄ؃̓΃σكԃӃ΃σЃ׃كƃ҃ʃǃăуՃ҃ՃڃЃσσ҃҃ۃ݃ȃ̓Ѓ˃ՃՃ˃̃̓ɃۃɃ��ك΃׃̓̓Ճȃփ˃؃̓܃̓҃փԃσՃЃɃЃǃ̓΃΃Ѓ̓҃҃كӃ׃΃Ӄ҃؃Ń̓ՃԃԃՃԃЃ؃҃σ΃̃Ѓ׃Ƀ˃؃̃ԃɃ΃Ѓԃуփك̓σۃ΃҃Ӄ؃҃ԃփуӃ؃̓׃у҃׃ԃփσуу݃Ӄ׃ԃՃ΃��ՃՃ؃ЃЃۃ̓Ճ̃у܃Ճ̓ԃ΃҃̓҃ȃу҃σكԃσ׃΃у҃ԃ҃Ѓ̃ǃσӃ׃Ճ΃΃׃ʃփӃփʃԃՃփ׃̃уՃ҃Ӄ΃փȃ̓Ń҃ԃԃ˃̃̓׃ԃ҃Ճԃу܃كσ҃҃ۃ̃̓كӃփσσуу̃̓҃̃ԃуփփكЃՃуʃ؃؃׃ȃ҃˃у΃؃ʃуʃЃ܃˃уσӃ҃҃ӃȃЃ؃׃ɃՃ˃ރ΃փ̓׃փ؃΃Ӄ׃̃уу�ԃ̃Ӄ҃Ƀԃ΃ԃуȃӃ׃уӃփՃԃ̃ԃЃσу߃Ѓ̃̓҃ӃՃуЃ̃փ؃փ҃σՃȃЃԃʃ̃ԃ׃؃ՃσՃ΃̓ʃɃЃڃӃЃσу̓ۃɃ׃׃уփЃ܃҃Ƀ׃ԃуԃ