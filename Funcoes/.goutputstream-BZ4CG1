import ccdproc 
import os
from astropy.nddata import CCDData
import numpy as np

def str2bool(valor):
	if valor == "True":
		return True
	if valor == "False":
		return False
	else:
		return "Non boolean"



def LerFicheiro(ficheiro):
	dic = {}
	with open(ficheiro,'r') as texto:
		while True:
			linha = texto.readline()
			if len(linha)!= 0 and linha[0] != '#' and linha[0]!= '\n':
				B = linha.strip().split()
				dic[B[0]] = str2bool(B[1])
			if linha == "":
				break
	return dic

def CriarMaster(Pasta, PastaFinal, Filtro, tipo):
	if tipo == 'flat':
		texto = '/MasterFlat'
	elif tipo == 'dark':
		texto = '/MasterDark'
	else:
		print('Tipo errado')
		return 0
	
	
	Ficheiros = [Pasta + x for x in os.listdir(Pasta)]
	Lidos = [CCDData.read(X, unit='adu') for X in Ficheiros]
	Master = ccdproc.combine(Lidos,method='median')
	Master.header['FILTRO'] = Filtro
	
	Master.write(PastaFinal + texto + Filtro + '.fits')
	return Master
